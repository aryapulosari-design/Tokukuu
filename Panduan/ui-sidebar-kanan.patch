+.app-shell .nav-label { color:var(--muted); }
+.app-shell .sidebar nav { gap:7px; }
+.app-shell .sidebar nav a,.app-shell .settings-link { color:#607086; padding:12px; border-radius:10px; font-size:13px; }
+.app-shell .sidebar nav a.active,.app-shell .settings-link.active { background:#edf3ff; color:#2859bb; font-weight:700; box-shadow:inset -3px 0 #3569d4; }
+.app-shell .sidebar nav a:not(.active):hover,.app-shell .settings-link:hover { background:#f4f6fa; }
+.app-shell .nav-active-dot { background:#3569d4; }
