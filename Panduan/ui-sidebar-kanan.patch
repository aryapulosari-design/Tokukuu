+/* Right-side tools, blue accents and separate metric cards. */
+.app-shell { --forest:#172740; --panel:#edf2fa; --lime:#dce8ff; --chalk:#f4f6fa; --text:#172740; --muted:#607086; --sage:#77869b; --mist:#bed3f6; --border:#e0e6ef; background:var(--chalk); color:var(--text); }
+.app-shell :focus-visible { outline-color:#3569d4; }
